# Configuración de Apache para el frontend (React + Vite).
# Vite copia este archivo a dist/ en cada build, así que se despliega solo.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # React Router maneja las rutas del lado del cliente (/pacientes, /ordenes/nueva…).
  # Apache no las conoce, así que toda petición que no corresponda a un archivo
  # real se sirve con index.html y deja que el router resuelva.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Los archivos con hash en el nombre (index-G2QicO7_.js) nunca cambian de
# contenido: se cachean un año. index.html no, para que un despliegue nuevo
# se vea de inmediato.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
